#VRML_SIM R2025a utf8
# Infrastructure smoke world: a flat floor only, no robot, sensors or warehouse.
# Only built-in Webots nodes are used, so nothing is downloaded at runtime.

WorldInfo {
  info [
    "Capstone smoke world: checks that Webots starts and /clock advances."
  ]
  basicTimeStep 4
  randomSeed 0
  optimalThreadCount 1
}
Viewpoint {
  orientation -0.5773 0.5773 0.5773 2.0944
  position 0 0 30
}
Background {
  skyColor [
    0.4 0.7 1
  ]
}
DirectionalLight {
  direction -0.3 -0.5 -1
}
Solid {
  translation 0 0 -0.05
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.6 0.6 0.6
        roughness 1
        metalness 0
      }
      geometry DEF FLOOR Box {
        size 20 20 0.1
      }
    }
  ]
  name "floor"
  boundingObject USE FLOOR
}
