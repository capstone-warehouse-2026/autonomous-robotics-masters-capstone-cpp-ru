#VRML_SIM R2025a utf8
# Самодостаточный мир интеграции G5/Nav2: реальные моторы, энкодеры и LiDAR.
WorldInfo {
  info ["G5 physical integration warehouse; static geometry matches map.pgm"]
  basicTimeStep 20
  coordinateSystem "ENU"
  randomSeed 42
  contactProperties [
    ContactProperties { material1 "wheel" material2 "floor" coulombFriction [ 1.2 ] bounce 0 }
    ContactProperties { material1 "caster" material2 "floor" coulombFriction [ 0.01 ] bounce 0 }
  ]
}
Viewpoint { orientation 0.57735 0.57735 0.57735 2.0944 position 0 0 15 }
Background { skyColor [ 0.25 0.3 0.35 ] }
DirectionalLight { direction -0.5 -0.5 -1 intensity 1 }
DEF FLOOR Solid {
  translation 0 0 -0.05
  children [ Shape { appearance PBRAppearance { baseColor 0.65 0.65 0.65 roughness 1 metalness 0 } geometry Box { size 12.4 10.4 0.1 } } ]
  name "floor"
  contactMaterial "floor"
  boundingObject Box { size 12.4 10.4 0.1 }
}
DEF WALL_W Solid {
  translation -5.95 0 0.75
  children [ Shape { appearance DEF WALL_APPEARANCE PBRAppearance { baseColor 0.7 0.72 0.75 roughness 1 metalness 0 } geometry Box { size 0.1 10 1.5 } } ]
  name "west_wall"
  boundingObject Box { size 0.1 10 1.5 }
}
DEF WALL_E Solid {
  translation 5.95 0 0.75
  children [ Shape { appearance USE WALL_APPEARANCE geometry Box { size 0.1 10 1.5 } } ]
  name "east_wall"
  boundingObject Box { size 0.1 10 1.5 }
}
DEF WALL_N Solid {
  translation 0 4.95 0.75
  children [ Shape { appearance USE WALL_APPEARANCE geometry Box { size 12 0.1 1.5 } } ]
  name "north_wall"
  boundingObject Box { size 12 0.1 1.5 }
}
DEF WALL_S Solid {
  translation 0 -4.95 0.75
  children [ Shape { appearance USE WALL_APPEARANCE geometry Box { size 12 0.1 1.5 } } ]
  name "south_wall"
  boundingObject Box { size 12 0.1 1.5 }
}
DEF CENTRAL_SHELF Solid {
  translation 0 0 0.75
  children [ Shape { appearance PBRAppearance { baseColor 0.25 0.4 0.65 roughness 0.8 metalness 0 } geometry Box { size 1 4 1.5 } } ]
  name "central_shelf"
  boundingObject Box { size 1 4 1.5 }
}
# Несимметричный стеллаж помогает AMCL различать север и юг склада.
DEF NORTHWEST_SHELF Solid {
  translation -4 3.25 0.75
  children [ Shape { appearance USE WALL_APPEARANCE geometry Box { size 1.2 1 1.5 } } ]
  name "northwest_shelf"
  boundingObject Box { size 1.2 1 1.5 }
}
DEF ROBOT Robot {
  translation -3 0 0.0985
  children [
    Pose {
      translation 0 0 0.1
      children [ Shape { appearance PBRAppearance { baseColor 0.1 0.5 0.85 roughness 0.7 metalness 0 } geometry Cylinder { radius 0.28 height 0.15 } } ]
    }
    Lidar {
      translation 0 0 0.25
      name "lidar"
      horizontalResolution 360
      fieldOfView 6.283185307179586
      verticalFieldOfView 0.02
      numberOfLayers 1
      near 0.02
      minRange 0.05
      maxRange 12
      noise 0.0
      projection "cylindrical"
    }
    DEF LEFT_JOINT HingeJoint {
      jointParameters HingeJointParameters { axis 0 1 0 anchor 0 0.2022 0 }
      device [
        RotationalMotor { name "left_motor" maxVelocity 10 maxTorque 20 }
        PositionSensor { name "left_encoder" }
      ]
      endPoint Solid {
        translation 0 0.2022 0
        rotation 1 0 0 1.5707963267948966
        children [ Shape { appearance DEF WHEEL_APPEARANCE PBRAppearance { baseColor 0.05 0.05 0.05 roughness 1 metalness 0 } geometry Cylinder { radius 0.0985 height 0.04 subdivision 32 } } ]
        name "left_wheel"
        contactMaterial "wheel"
        boundingObject Cylinder { radius 0.0985 height 0.04 subdivision 32 }
        physics Physics { density -1 mass 1 }
      }
    }
    DEF RIGHT_JOINT HingeJoint {
      jointParameters HingeJointParameters { axis 0 1 0 anchor 0 -0.2022 0 }
      device [
        RotationalMotor { name "right_motor" maxVelocity 10 maxTorque 20 }
        PositionSensor { name "right_encoder" }
      ]
      endPoint Solid {
        translation 0 -0.2022 0
        rotation 1 0 0 1.5707963267948966
        children [ Shape { appearance USE WHEEL_APPEARANCE geometry Cylinder { radius 0.0985 height 0.04 subdivision 32 } } ]
        name "right_wheel"
        contactMaterial "wheel"
        boundingObject Cylinder { radius 0.0985 height 0.04 subdivision 32 }
        physics Physics { density -1 mass 1 }
      }
    }
    Solid {
      translation 0.22 0 -0.06
      children [ Shape { appearance USE WHEEL_APPEARANCE geometry Sphere { radius 0.0385 } } ]
      name "front_support"
      contactMaterial "caster"
      boundingObject Sphere { radius 0.0385 }
      physics Physics { density -1 mass 0.1 }
    }
    Solid {
      translation -0.22 0 -0.06
      children [ Shape { appearance USE WHEEL_APPEARANCE geometry Sphere { radius 0.0385 } } ]
      name "rear_support"
      contactMaterial "caster"
      boundingObject Sphere { radius 0.0385 }
      physics Physics { density -1 mass 0.1 }
    }
  ]
  name "g5_robot"
  controller "<extern>"
  supervisor TRUE
  synchronization TRUE
  boundingObject Pose { translation 0 0 0.1 children [ Cylinder { radius 0.28 height 0.15 } ] }
  physics Physics { density -1 mass 20 centerOfMass [ 0 0 0.02 ] damping Damping { linear 0.05 angular 0.8 } }
}
