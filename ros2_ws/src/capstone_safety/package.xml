<?xml version="1.0"?>
<package format="3">
  <name>capstone_safety</name>
  <version>0.1.0</version>
  <description>G4: independent safety monitor, the only /cmd_vel publisher.</description>
  <maintainer email="g4@example.invalid">G4</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <!-- Dependencies are rosdep keys; `make build` installs them into the dev image. -->
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>lifecycle_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <exec_depend>launch_ros</exec_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
