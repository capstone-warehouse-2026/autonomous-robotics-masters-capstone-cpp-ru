<?xml version="1.0"?>
<package format="3">
  <name>capstone_planning</name>
  <version>0.1.0</version>
  <description>G3: global planning in a changing environment; method A (A* with a fixed cost) and method B (A* with a learned CNN cost).</description>
  <maintainer email="g3@example.invalid">G3</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <!-- Dependencies are rosdep keys; `make build` installs them into the dev image. -->
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>nav2_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>ament_index_cpp</depend>
  <!-- ONNX Runtime (method B) has no rosdep key: it is installed in docker/Dockerfile, stage dev. -->
  <exec_depend>launch_ros</exec_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <!-- numpy for ml/planning/evaluate.py (make g3-eval) in the dev image. -->
  <exec_depend>python3-numpy</exec_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
