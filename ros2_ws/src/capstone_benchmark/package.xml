<?xml version="1.0"?>
<package format="3">
  <name>capstone_benchmark</name>
  <version>0.1.0</version>
  <description>G5: C++ benchmark runner and metrics aggregator and isolated dispatch experiments.</description>
  <maintainer email="g5@example.invalid">G5</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <!-- Dependencies are rosdep keys; `make build` installs them into the dev image. -->
  <depend>rclcpp</depend>
  <depend>std_srvs</depend><depend>rosgraph_msgs</depend>
  <depend>nav_msgs</depend><depend>diagnostic_msgs</depend>
  <depend>capstone_mission</depend>
  <depend>yaml-cpp</depend>
  <depend>openssl</depend>
  <exec_depend>capstone_debug_navigation</exec_depend>
  <exec_depend>launch_ros</exec_depend><exec_depend>ament_index_python</exec_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
